# MedRAG-X backend environment (SECRET values — never commit real keys)

# Groq Cloud API key (https://console.groq.com/keys). Free tier, no credit card.
# If empty/missing, the app falls back to a transparent extractive MockLLM so the
# RAG pipeline still works end-to-end for local testing.
LLM_API_KEY=

# Groq model id (see https://console.groq.com/docs/models)
LLM_MODEL=openai/gpt-oss-120b

# Comma-separated allowed CORS origins for the frontend (PUBLIC value)
ALLOWED_ORIGINS=http://localhost:3000

# Log level: DEBUG | INFO | WARNING (PUBLIC)
LOG_LEVEL=INFO
